# ── DEGEN•SPORTS Article Generator — Environment Variables ──────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Backend URL (your Express server — default port 5001)
BACKEND_URL=http://localhost:5001

# Admin token — must match what's in server.js (adminAuth middleware)
# Default in server.js is: admin-secret-token
ADMIN_TOKEN=admin-secret-token

# Ollama settings
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434
